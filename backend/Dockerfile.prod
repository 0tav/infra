# Base Image Linux Ringan dengan OpenSSL bawaan untuk Prisma
FROM node:20-alpine
RUN apk add --no-cache openssl libc6-compat dos2unix

# Aktifkan corepack untuk pnpm bersih versi Linux Cloud
ENV COREPACK_ENABLE=1
RUN npm i -g pnpm

WORKDIR /app

# 1. Hanya salin file package untuk menjaga cache instalasi
COPY package.json pnpm-lock.yaml* ./

# 2. Salin folder prisma sebelum install agar client terikat dengan benar
COPY prisma ./prisma/

# 3. Instal dependency TANPA flag hoisted (Hemat RAM 70% & Hindari Error Biner)
RUN pnpm install --frozen-lockfile

# 4. Salin seluruh sisa file kode backend
COPY . .

# 5. Generate Prisma Client versi Linux Cloud
RUN pnpm prisma generate

# 6. Build TypeScript menjadi JavaScript
RUN pnpm build

# 7. Konfigurasi Port dan Environment
EXPOSE 10000
ENV PORT=10000
ENV NODE_ENV=production

# 8. Jalankan entrypoint Anda
COPY entrypoint.sh ./entrypoint.sh
RUN dos2unix ./entrypoint.sh && chmod +x ./entrypoint.sh

ENTRYPOINT ["./entrypoint.sh"]
CMD ["pnpm", "start"]
